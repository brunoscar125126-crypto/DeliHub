generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Guarda o token de acesso vigente de cada plataforma (iFood, 99Food, Keeta...).
// lib/tokenManager.js é o único lugar do sistema que lê/escreve nesta tabela.
model PlatformToken {
  id        String   @id @default(cuid())
  platform  String   @unique // "ifood" | "noventaenove" | "keeta"
  token     String   @db.Text
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_tokens")
}

enum StatusProduto {
  ATIVO
  PAUSADO
}

// Produto "canônico" do sistema — a fonte de verdade interna, independente
// de plataforma. nome/descricao/precoCentavos são os valores base; cada
// plataforma pode ter seu próprio preço/status via ProdutoPlataforma.
model Produto {
  id            String        @id @default(cuid())
  nome          String
  descricao     String?
  categoria     String?
  precoCentavos Int
  // Custo de produção — opcional; a margem exibida no dashboard só aparece
  // quando isso está preenchido (não inventamos margem sem custo real).
  custoCentavos Int?
  // Se ausente, o frontend mostra um círculo colorido com a inicial do nome
  // em vez da imagem — não há upload de imagem neste projeto ainda.
  imagemUrl     String?
  // Código PDV interno — referência única do produto, pensado para o
  // matching/merge entre plataformas no onboarding do futuro SaaS.
  externalCode  String?       @unique
  status        StatusProduto @default(ATIVO)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  plataformas ProdutoPlataforma[]

  @@map("produtos")
}

// Mapeamento de um Produto para o item equivalente em uma plataforma
// específica (iFood, 99Food, Keeta...). Uma linha por produto × plataforma.
model ProdutoPlataforma {
  id        String  @id @default(cuid())
  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  // "ifood" | "noventaenove" | "keeta" — mesmos valores usados em PlatformToken.platform
  plataforma String

  // ID do item nessa plataforma: uuid (item.productId) no iFood,
  // app_item_id (string) na 99Food.
  itemId String

  // Sobrescreve precoCentavos do Produto nesta plataforma (taxas diferentes
  // por plataforma); null = usa o preço base.
  precoCentavos Int?

  // Pode divergir do status "canônico" do Produto durante uma sincronização
  // parcial (ex: chamada falhou numa plataforma e não nas outras).
  status StatusProduto @default(ATIVO)

  // Última vez que este mapeamento foi confirmado sincronizado com a API da plataforma.
  sincronizadoEm DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([produtoId, plataforma])
  @@unique([plataforma, itemId])
  @@map("produto_plataformas")
}

// Guarda o payload BRUTO de todo evento de pedido recebido (webhook da
// 99Food) ou coletado (polling do iFood). Nenhuma das duas plataformas tem
// o formato do payload confirmado ainda neste projeto — esta tabela é a
// fonte de verdade pra descobrir o formato real assim que o primeiro evento
// chegar, em vez de assumir um schema às cegas.
model EventoPedido {
  id         String   @id @default(cuid())
  plataforma String // "ifood" | "noventaenove"
  origem     String // "webhook" | "polling"
  payload    Json
  processado Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("eventos_pedido")
}

// Pedido — upsertado a cada evento de status recebido de qualquer
// plataforma (99Food via webhook, iFood via webhook+polling), não só na
// criação. shop/price/receiveAddress/orderItems ficam como Json porque
// ainda não temos o sub-schema completo de cada um confirmado — payloadBruto
// guarda o payload cru inteiro como rede de segurança.
//
// DeliHub não decide mais aceitar/recusar pedido — isso passou a ser feito
// direto no app oficial de cada plataforma. Este model é só histórico/
// leitura do status real relatado pela plataforma.
model Pedido {
  id             String    @id @default(cuid())
  plataforma     String
  // order_id da plataforma. 64-bit na 99Food — guardado como string pra não
  // perder precisão (ver nota sobre json-bigint em routes/webhooks.js).
  orderId        String
  // Código numérico de status da 99Food (ex: 100). Opcional porque o iFood
  // não tem um análogo numérico — usa strings (ver statusEvento).
  status         Int?
  // O "type"/"code" cru que a plataforma mandou nesse evento (99Food:
  // "orderNew" etc.; iFood: "PLC"/"CFM"/"RTP"/"DSP"/"CON"/"CAN" ou os
  // fullCode equivalentes) — é o campo que o frontend usa pra mostrar o
  // status legível (novo/confirmado/pronto/saiu para entrega/entregue/
  // cancelado). Sempre o valor do ÚLTIMO evento processado pra esse pedido.
  statusEvento   String?
  shop           Json
  price          Json
  receiveAddress Json
  orderItems     Json
  payloadBruto   Json
  // Campo legado de quando o DeliHub confirmava pedido automaticamente —
  // mantido só como histórico dos pedidos já confirmados por esse sistema
  // antigo; não é mais escrito por nenhuma rota.
  confirmadoEm   DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([plataforma, orderId])
  @@map("pedidos")
}
