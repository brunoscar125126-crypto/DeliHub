# Banco de dados (em produção, o Railway provisiona e injeta essa variável automaticamente)
DATABASE_URL="postgresql://user:password@localhost:5432/delihub?schema=public"

# 99Food (https://openapi.didi-food.com)
NOVENTAENOVE_APP_ID=
NOVENTAENOVE_APP_SECRET=
NOVENTAENOVE_APP_SHOP_ID=

# iFood (https://merchant-api.ifood.com.br)
# Durante o desenvolvimento, use o app de teste "Centralizado" (Meus apps),
# não o app oficial "DeliHub" — esse exige homologação antes de liberar credenciais.
IFOOD_CLIENT_ID=
IFOOD_CLIENT_SECRET=
# ID da loja (merchant) no iFood — obtido via connectors/ifood.js:listarLojas().
# Modelo atual é single-tenant (uma loja só); no SaaS futuro isso vira uma
# coluna por lojista em vez de variável de ambiente.
IFOOD_MERCHANT_ID=

PORT=3000
NODE_ENV=development
